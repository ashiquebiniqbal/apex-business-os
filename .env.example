# Browser-safe Supabase settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy compatibility fallback; leave blank when using the publishable key.
VITE_SUPABASE_ANON_KEY=

# Configure these as Supabase Edge Function secrets, not browser variables.
APP_ORIGIN=http://127.0.0.1:5173
META_API_URL=https://api.meta.ai/v1/responses
META_MODEL=muse-spark-1.3
META_API_KEY=your-meta-api-key
# Supabase Edge Function server-only secret; never use a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
